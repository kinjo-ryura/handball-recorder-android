<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 配信中のサンプル試合 / ハイライト JSON を取得する。これが無いと通信そのものが
         できず、アプリは空の一覧しか出せない。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- アイコンは 2 系統。API 26 以降は mipmap-anydpi-v26/ の adaptive icon が、
         API 24/25 は mipmap-*dpi/ の PNG が使われる（minSdk = 24 なので後者が要る）。
         roundIcon は端末側が丸いアイコンを求めたときだけ参照される。 -->
    <!-- allowBackup は明示的に切る（handball-project#285）。既定（true）だと WebView の
         domStorage（YouTube のセッション由来データ）が Google Drive のバックアップ対象に
         入りうる。このアプリはユーザーの記録を持たないので、復元して嬉しいデータも無い。 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.HandballRecorder">
        <!-- configChanges で回転を自分で受ける。既定のまま（宣言なし）だと向きが変わる
             たびに Activity が作り直され、`WebView` を持つ YouTubePlayerController も
             一緒に捨てられる（= 動画が頭に戻る）。全画面は入るときに向きを横へ固定する
             ので、宣言が無いと入った瞬間に再生成が走って全画面そのものが成立しない。
             Compose は新しい Configuration を composition へ流すので、回転しても
             レイアウトとダークテーマの追随は変わらない。 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
