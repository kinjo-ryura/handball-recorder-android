<?xml version="1.0" encoding="utf-8"?>
<!-- ランチャーアイコンの前景（adaptive icon の <foreground>）。五角形を作る 5 本のバー。
     意匠は iOS 版（HandballRecorder.icon/Assets/*.svg）からの移植。琥珀 #F59E0B は
     3 アプリを貫く family の印で、背景の紫がハンド記録固有の色（apps-site の
     scripts/generate-brand-icon.sh のコメントが出どころ）。

     ■ 座標系
     viewport は元データと同じ 1024×1024。**パスは元の SVG からそのまま写せる**。
     ただし左上のバー（rect_top_left 2.svg）だけは元データが
     transform="translate(1024 0) scale(-1 1)" の中にあるため、x を 1024-x に置き換えて
     展開済み（見えている形は「右上のバーの左右反転」）。

     ■ 安全域（108dp のうち内側 72dp。外側 18dp ずつはマスクで切られる）
     5 本のバーの外接矩形は元座標で 704 × 669（角丸の制御点込み。実際に塗られる範囲は
     x 164.7..859.3 / y 148.8..811.0 = 695 × 662、中心は 512, 479.9）。
     これを <group> の scale 0.8 + translate(102.4, 130.8) で
     x 234.1..789.9 / y 249.9..779.6（= 24.7..83.3dp / 26.4..82.2dp、58.6 × 55.9dp）へ写す。
     1024 換算の安全域は 170.67..853.33 なので 4 辺とも内側に収まる
     （左右 63.5 単位 ≒ 6.7dp / 上下 79.2・73.7 単位 ≒ 8.4・7.8dp の余白）。
     円マスク（直径 72dp = 中心から 341.3 単位）にも収まる — 中心から最も遠い点は
     下バーの角で 313.7 単位 = 33.1dp。これは Android のキーライン（コンテンツは
     直径 66dp = 半径 33dp に収める）とほぼ同じ大きさ。
     **scale / translate を変えたら scripts/generate-launcher-icons.sh の定数
     （SCALE / TX / TY と、そこから導く LEG_*）も直すこと**（スクリプトが食い違いを検査して止まる）。

     ■ 元データにあって写していないもの
     rect_top_left 2.svg には、五角形とは別に**キャンバス外へはみ出した白い破片が 2 つ**
     入っている（右上と左下。iOS ではアイコンの縁で切れて見える）。adaptive icon は
     108dp のうち内側 66.7% しか見せないため、この 2 つを同じ構図で置くと五角形を
     ランチャーアイコンとして小さすぎる大きさまで縮めるか、左右で見え方が極端に
     偏るかのどちらかになる。**意図して落としている**（README「アイコン」参照）。

     色・形を変えたら scripts/generate-launcher-icons.sh を回して PNG も作り直すこと。
     このファイルが PNG フォールバックの唯一の出どころで、スクリプトはここから読む。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <group
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateX="102.4"
        android:translateY="130.8">
        <!-- 右上（rect_top_right 4.svg） -->
        <path
            android:fillColor="#F59E0B"
            android:pathData="M 528.2,153.8 L 847.8,386.2 Q 864,398 852.2,414.2 L 757.8,543.8 Q 746,560 729.8,548.2 L 410.2,315.8 Q 394,304 405.8,287.8 L 500.2,158.2 Q 512,142 528.2,153.8 Z" />
        <!-- 右下（rect_bottom_right 2.svg） -->
        <path
            android:fillColor="#F59E0B"
            android:pathData="M 857.8,417.0 L 735.2,792.0 Q 729,811 710.0,804.8 L 558.0,755.2 Q 539,749 545.2,730.0 L 667.8,355.0 Q 674,336 693.0,342.2 L 845.0,391.8 Q 864,398 857.8,417.0 Z" />
        <!-- 下（rect_bottom 2.svg） -->
        <path
            android:fillColor="#F59E0B"
            android:pathData="M 709,811 L 315,811 Q 295,811 295,791 L 295,631 Q 295,611 315,611 L 709,611 Q 729,611 729,631 L 729,791 Q 729,811 709,811 Z" />
        <!-- 左下（rect_bottom_left 2.svg） -->
        <path
            android:fillColor="#F59E0B"
            android:pathData="M 288.8,792.0 L 166.2,417.0 Q 160,398 179.0,391.8 L 331.0,342.2 Q 350,336 356.2,355.0 L 478.8,730.0 Q 485,749 466.0,755.2 L 314.0,804.8 Q 295,811 288.8,792.0 Z" />
        <!-- 左上（rect_top_left 2.svg の 1 本目のパスを左右反転して展開したもの）。
             元データどおり白で、iOS では下の琥珀が透けるので少しだけ透過させている。 -->
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.9"
            android:pathData="M 495.8,153.8 L 176.2,386.2 Q 160,398 171.8,414.2 L 266.2,543.8 Q 278,560 294.2,548.2 L 613.8,315.8 Q 630,304 618.2,287.8 L 523.8,158.2 Q 512,142 495.8,153.8 Z" />
    </group>
</vector>
